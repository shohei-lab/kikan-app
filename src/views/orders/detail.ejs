<%- include('../partials/header') %>
<h1>受注詳細: <%= order.order_no %></h1>

<div class="stat-grid">
  <div class="stat-card"><div class="num"><%= order.customer_name %></div><div class="label">顧客名</div></div>
  <div class="stat-card"><div class="num"><%= order.status %></div><div class="label">現在のステータス</div></div>
</div>

<table style="margin-bottom: 1.5rem;">
  <thead><tr><th>SKU</th><th>商品名</th><th>数量</th><th>単価</th></tr></thead>
  <tbody>
    <% items.forEach(i => { %>
    <tr>
      <td><%= i.sku %></td>
      <td><%= i.product_name %></td>
      <td><%= i.quantity %></td>
      <td><%= i.unit_price_snapshot.toLocaleString() %>円</td>
    </tr>
    <% }) %>
  </tbody>
</table>

<form class="card" action="/orders/<%= order.id %>/status" method="POST">
  <label>ステータス変更</label>
  <select name="status">
    <% ['受付', '処理中', '出荷済', 'キャンセル'].forEach(s => { %>
    <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <div style="margin-top: 1rem;">
    <button class="btn" type="submit">更新</button>
  </div>
</form>
<%- include('../partials/footer') %>
