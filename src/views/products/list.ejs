<%- include('../partials/header') %>
<div class="toolbar">
  <h1>商品マスタ</h1>
  <a class="btn" href="/products/new">+ 新規登録</a>
</div>
<table>
  <thead><tr><th>SKU</th><th>商品名</th><th>単位</th><th>単価</th><th></th></tr></thead>
  <tbody>
    <% products.forEach(p => { %>
    <tr>
      <td><%= p.sku %></td>
      <td><%= p.name %></td>
      <td><%= p.unit %></td>
      <td><%= p.unit_price.toLocaleString() %>円</td>
      <td><a href="/products/<%= p.id %>/edit">編集</a></td>
    </tr>
    <% }) %>
    <% if (products.length === 0) { %>
    <tr><td colspan="5">商品が登録されていません</td></tr>
    <% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
