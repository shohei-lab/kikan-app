# --- ローカル開発時: 以下を直接設定 ---
DATABASE_URL=postgres://kikan_app:CHANGE_ME@localhost:5432/kikan_db
SESSION_SECRET=CHANGE_ME_RANDOM_STRING
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# --- 本番(VM)環境: これを設定すると上記4つの代わりにKey Vaultから取得する ---
# AZURE_KEY_VAULT_URL=https://kv-kikan-xxxxxx.vault.azure.net/

PORT=3000
